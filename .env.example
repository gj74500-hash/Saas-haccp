# ============================================================================
# HACCP Pro — environment variables
#
# Local development: copy this file to .env and fill in the values.
# Vercel/Railway/Render: set these in the host's Environment Variables UI —
# the .env file in the repo is NOT read by hosting platforms.
# ============================================================================

# --- REQUIRED ---------------------------------------------------------------

# PostgreSQL connection string.
#   Local (docker compose): postgresql://haccp:haccp@localhost:5432/haccp_pro?schema=public
#   Hosted (Neon/Supabase/…): usually needs ?sslmode=require at the end.
DATABASE_URL="postgresql://haccp:haccp@localhost:5432/haccp_pro?schema=public"

# Session signing secret — REQUIRED in production, the app will not start
# without it. Generate with:  openssl rand -base64 32
#
# This project uses Auth.js v5 (next-auth@5), whose canonical variable name
# is AUTH_SECRET. The NextAuth v4 name NEXTAUTH_SECRET is also accepted as
# an alias — set either one, AUTH_SECRET wins if both are present.
AUTH_SECRET="change-me-in-production"
# NEXTAUTH_SECRET=""   # v4-style alias, only needed if you prefer the old name

# --- RECOMMENDED ------------------------------------------------------------

# Public URL of the app — used in password-reset emails and PWA links.
#   Local: http://localhost:3000
#   Vercel: https://<your-project>.vercel.app
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- OPTIONAL ---------------------------------------------------------------

# SMTP for outgoing email. When unset, emails (e.g. password-reset links)
# are printed to the server console instead — fine for development.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="HACCP Pro <no-reply@haccppro.app>"
