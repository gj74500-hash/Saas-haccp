# PostgreSQL connection string
DATABASE_URL="postgresql://haccp:haccp@localhost:5432/haccp_pro?schema=public"

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET="change-me-in-production"
AUTH_TRUST_HOST="true"

# Public app URL (used in emails and PWA)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# SMTP (optional in development — emails are logged to the console when unset)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="HACCP Pro <no-reply@haccppro.app>"
